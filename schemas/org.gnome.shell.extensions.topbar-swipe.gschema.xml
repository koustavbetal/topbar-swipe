<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="topbar-swipe">
<schema id="org.gnome.shell.extensions.topbar-swipe" path="/org/gnome/shell/extensions/topbar-swipe/">

  <!-- ===== Shared appearance ===== -->
  <key name="swipe-opacity" type="d"><default>0.35</default><range min="0.05" max="1.0"/><summary>Bar max opacity</summary></key>
  <key name="swipe-radius" type="i"><default>0</default><range min="0" max="200"/><summary>Bar border radius in px</summary></key>

  <!-- ===== Shared timing — ONE style per direction family, used by ==== -->
  <!-- ===== ambient, notifications, and device reactions alike.       ==== -->
  <key name="swipe-lr-width" type="i"><default>200</default><range min="20" max="2000"/><summary>Side (LTR/RTL) stroke length</summary></key>
  <key name="swipe-lr-duration" type="i"><default>800</default><range min="100" max="10000"/><summary>Side (LTR/RTL) stroke duration</summary></key>
  <key name="swipe-lr-stroke-gap" type="i"><default>150</default><range min="0" max="5000"/><summary>Side (LTR/RTL) gap between strokes</summary></key>
  <key name="swipe-lr-cycle-gap" type="i"><default>500</default><range min="0" max="60000"/><summary>Side (LTR/RTL) gap between cycles / idle interval</summary></key>

  <key name="swipe-center-width" type="i"><default>140</default><range min="20" max="2000"/><summary>Center-out stroke length</summary></key>
  <key name="swipe-center-duration" type="i"><default>1000</default><range min="100" max="10000"/><summary>Center-out stroke duration</summary></key>
  <key name="swipe-center-stroke-gap" type="i"><default>200</default><range min="0" max="5000"/><summary>Center-out gap between strokes</summary></key>
  <key name="swipe-center-cycle-gap" type="i"><default>600</default><range min="0" max="60000"/><summary>Center-out gap between cycles / idle interval</summary></key>

  <!-- ===== Ambient ===== -->
  <key name="swipe-color" type="s"><default>'#50a0ff'</default><summary>Ambient color</summary></key>
  <key name="swipe-direction" type="s">
    <choices><choice value="ltr"/><choice value="rtl"/><choice value="center-out"/></choices>
    <default>'ltr'</default>
    <summary>Ambient direction</summary>
  </key>
  <key name="idle-loop-enabled" type="b"><default>true</default><summary>Run ambient swipe loop</summary></key>
  <key name="ambient-stroke-count" type="i"><default>1</default><range min="1" max="10"/><summary>Ambient strokes per cycle</summary></key>

  <!-- ===== Notifications ===== -->
  <key name="notifications-enabled" type="b"><default>true</default><summary>React to notifications</summary></key>
  <key name="notif-default-color" type="s"><default>'#50a0ff'</default><summary>Fallback color for apps with no rule</summary></key>
  <key name="notif-default-direction" type="s">
    <choices><choice value="ltr"/><choice value="rtl"/><choice value="center-out"/></choices>
    <default>'ltr'</default>
    <summary>Fallback direction for apps with no rule</summary>
  </key>
  <key name="default-stroke-count" type="i"><default>2</default><range min="1" max="10"/><summary>Fallback stroke count for apps with no rule</summary></key>
  <key name="default-cycle-count" type="i"><default>3</default><range min="1" max="20"/><summary>Fallback cycle count for apps with no rule</summary></key>
  <key name="app-rules" type="s"><default>'[]'</default><summary>JSON array of per-app rules (appName, titleFilter, color, strokeCount, cycleCount, direction)</summary></key>

  <!-- ===== Device reactions ===== -->
  <key name="device-enabled" type="b"><default>false</default><summary>Master toggle for device-event reactions</summary></key>

  <key name="power-react-enabled" type="b"><default>false</default><summary>React when charger is connected</summary></key>
  <key name="power-color" type="s"><default>'#50c878'</default><summary>Power-connect color</summary></key>
  <key name="power-direction" type="s">
    <choices><choice value="ltr"/><choice value="rtl"/><choice value="center-out"/></choices>
    <default>'ltr'</default>
    <summary>Power-connect direction</summary>
  </key>
  <key name="power-stroke-count" type="i"><default>1</default><range min="1" max="10"/><summary>Power-connect strokes per cycle</summary></key>
  <key name="power-cycle-count" type="i"><default>1</default><range min="1" max="20"/><summary>Power-connect cycles</summary></key>

  <key name="bt-react-enabled" type="b"><default>false</default><summary>React when a Bluetooth device connects</summary></key>
  <key name="bt-color" type="s"><default>'#4aa3ff'</default><summary>Bluetooth-connect color</summary></key>
  <key name="bt-direction" type="s">
    <choices><choice value="ltr"/><choice value="rtl"/><choice value="center-out"/></choices>
    <default>'ltr'</default>
    <summary>Bluetooth-connect direction</summary>
  </key>
  <key name="bt-stroke-count" type="i"><default>1</default><range min="1" max="10"/><summary>Bluetooth-connect strokes per cycle</summary></key>
  <key name="bt-cycle-count" type="i"><default>1</default><range min="1" max="20"/><summary>Bluetooth-connect cycles</summary></key>
  <key name="bt-name-filter" type="s"><default>''</default><summary>Optional substring filter on device name/alias</summary></key>

  <!-- ===== Advanced / API ===== -->
  <key name="api-enabled" type="b"><default>false</default><summary>Master toggle for the trigger button / API surface</summary></key>
  <key name="trigger-button-position" type="s">
    <choices><choice value="left"/><choice value="center"/><choice value="right"/><choice value="key"/></choices>
    <default>'right'</default>
    <summary>Where the trigger button lives, or 'key' for a keybinding instead</summary>
  </key>
  <key name="trigger-button-key" type="as"><default>[]</default><summary>Keybinding accelerator, used when position is 'key'</summary></key>
  <key name="quick-scripts" type="s"><default>'[]'</default><summary>JSON array of {name, command} shown under the trigger button</summary></key>

    <!-- ===== Quick-script output label ===== -->
  <key name="output-label-font" type="s">
    <default>'Sans'</default>
    <summary>Output label font family</summary>
  </key>

  <key name="output-label-font-size" type="i">
    <default>14</default>
    <range min="6" max="72"/>
    <summary>Output label font size in pixels</summary>
  </key>

  <key name="output-label-bold" type="b">
    <default>false</default>
    <summary>Use bold output label</summary>
  </key>

  <key name="output-label-debug" type="b">
    <default>false</default>
    <summary>Show hard-coded output debug text</summary>
  </key>


</schema>
</schemalist>